<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/webbox_background" />
            <size
                android:width="320dp"
                android:height="180dp" />
        </shape>
    </item>
    <item
        android:bottom="40dp"
        android:left="40dp"
        android:right="40dp"
        android:top="40dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/webbox_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
