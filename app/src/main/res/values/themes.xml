<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WebBox" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/webbox_primary</item>
        <item name="colorPrimaryDark">@color/webbox_primary_dark</item>
        <item name="colorAccent">@color/webbox_accent</item>
        <item name="android:windowBackground">@color/webbox_background</item>
        <item name="android:colorBackground">@color/webbox_background</item>
        <item name="android:textColorPrimary">@color/webbox_text_primary</item>
        <item name="android:textColorSecondary">@color/webbox_text_secondary</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.WebBox.Fullscreen" parent="Theme.WebBox">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.WebBox.Settings" parent="Theme.WebBox">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="WebBox.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/webbox_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="WebBox.Label" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/webbox_text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="WebBox.Secondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/webbox_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="WebBox.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/bg_button_tint</item>
        <item name="android:textColor">@color/webbox_text_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/bg_button_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="WebBox.Button.Primary" parent="WebBox.Button">
        <item name="backgroundTint">@color/bg_button_primary_tint</item>
    </style>

    <style name="WebBox.EditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/webbox_primary</item>
        <item name="hintTextColor">@color/webbox_text_secondary</item>
        <item name="android:textColorHint">@color/webbox_text_secondary</item>
    </style>
</resources>
